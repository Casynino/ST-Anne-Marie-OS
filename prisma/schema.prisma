// St Anne Marie Schools — Phase 1 (Foundation) + Phase 2 (Admissions & Attendance) schema.
// Conventions:
//  * Every school-owned row carries schoolId; services always filter by it.
//  * Calendar dates (dob, term dates, admission date) use @db.Date; timestamps are UTC.
//  * Extra integrity rules that Prisma cannot express (partial unique indexes,
//    CHECK constraints, append-only audit log) live in the migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Locale {
  EN
  SW
}

enum UserType {
  STAFF
  GUARDIAN
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ENROLLED
  TRANSFERRED
  WITHDRAWN
  GRADUATED
}

enum EnrollmentStatus {
  ACTIVE
  MOVED
  COMPLETED
  TRANSFERRED_OUT
  WITHDRAWN
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GRANDPARENT
  UNCLE
  AUNT
  SIBLING
  GUARDIAN
  OTHER
}

// ───────────────────────── Tenancy ─────────────────────────

model School {
  id            String   @id @default(uuid(7)) @db.Uuid
  code          String   @unique
  name          String
  motto         String?
  logoUrl       String?
  email         String?
  phone         String?
  address       String?
  timezone      String   @default("Africa/Dar_es_Salaam")
  currency      String   @default("TZS")
  defaultLocale Locale   @default(EN)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branches               Branch[]
  users                  User[]
  roles                  Role[]
  staff                  Staff[]
  settings               SchoolSetting[]
  auditLogs              AuditLog[]
  academicYears          AcademicYear[]
  terms                  Term[]
  levels                 AcademicLevel[]
  classes                SchoolClass[]
  streams                Stream[]
  subjects               Subject[]
  classSubjects          ClassSubject[]
  classTeachers          ClassTeacher[]
  subjectTeachers        SubjectTeacher[]
  students               Student[]
  guardians              Guardian[]
  studentGuardians       StudentGuardian[]
  enrollments            StudentEnrollment[]
  emergencyContacts      EmergencyContact[]
  statusHistory          StudentStatusHistory[]
  admissionCounters      AdmissionCounter[]
  attendanceSessions     AttendanceSession[]
  attendanceRegisters    AttendanceRegister[]
  studentAttendance      StudentAttendance[]
  attendanceCorrections  AttendanceCorrection[]
  attendanceOperations   AttendanceOperation[]
  staffAttendance        StaffAttendance[]
  notificationEvents     NotificationEvent[]
  notificationDeliveries NotificationDelivery[]
  inAppNotifications     InAppNotification[]
  applications           Application[]
  applicationEvents      ApplicationEvent[]
  documents              Document[]
  importBatches          ImportBatch[]
  importRows             ImportRow[]
  announcements          Announcement[]
  events                 SchoolEvent[]
  enquiries              Enquiry[]
  mediaAssets            MediaAsset[]
  gradingScales          GradingScale[]
  exams                  Exam[]
  examSubjects           ExamSubject[]
  resultSubmissions      ResultSubmission[]
  marks                  Mark[]
  resultChanges          ResultChange[]

  @@map("schools")
}

model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  code      String
  address   String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])
  users  User[]

  @@unique([schoolId, code])
  @@map("branches")
}

model SchoolSetting {
  id          String   @id @default(uuid(7)) @db.Uuid
  schoolId    String   @db.Uuid
  key         String
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, key])
  @@map("school_settings")
}

// ───────────────────────── Identity & access ─────────────────────────

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  schoolId           String     @db.Uuid
  branchId           String?    @db.Uuid
  type               UserType   @default(STAFF)
  fullName           String
  email              String?    @unique // stored lowercase
  phone              String?    @unique // stored as +255XXXXXXXXX
  passwordHash       String
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true)
  locale             Locale     @default(EN)
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  school   School     @relation(fields: [schoolId], references: [id])
  branch   Branch?    @relation(fields: [branchId], references: [id])
  roles    UserRole[]
  sessions Session[]
  staff    Staff?
  guardian Guardian?

  @@index([schoolId, type])
  @@map("users")
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginAttempt {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  ip         String?
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  schoolId    String   @db.Uuid
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  school      School           @relation(fields: [schoolId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([schoolId, key])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  key         String  @unique
  module      String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String   @db.Uuid
  roleId       String   @db.Uuid
  assignedAt   DateTime @default(now())
  assignedById String?  @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Staff {
  id         String    @id @default(uuid(7)) @db.Uuid
  schoolId   String    @db.Uuid
  userId     String    @unique @db.Uuid
  staffNo    String?
  jobTitle   String?
  employedOn DateTime? @db.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  school           School           @relation(fields: [schoolId], references: [id])
  user             User             @relation(fields: [userId], references: [id])
  classTeacherOf   ClassTeacher[]
  subjectTeacherOf SubjectTeacher[]

  @@unique([schoolId, staffNo])
  @@map("staff")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  schoolId   String   @db.Uuid
  actorId    String?  @db.Uuid
  actorName  String?
  action     String
  entityType String
  entityId   String?
  summary    String?
  changes    Json?
  reason     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, createdAt])
  @@index([schoolId, entityType, entityId])
  @@index([schoolId, actorId])
  @@map("audit_logs")
}

// ───────────────────────── Academic structure ─────────────────────────

model AcademicYear {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school          School              @relation(fields: [schoolId], references: [id])
  terms           Term[]
  enrollments     StudentEnrollment[]
  classTeachers   ClassTeacher[]
  subjectTeachers SubjectTeacher[]

  @@unique([schoolId, name])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(uuid(7)) @db.Uuid
  schoolId       String   @db.Uuid
  academicYearId String   @db.Uuid
  name           String
  sequence       Int
  startsOn       DateTime @db.Date
  endsOn         DateTime @db.Date
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([academicYearId, sequence])
  @@unique([academicYearId, name])
  @@map("terms")
}

model AcademicLevel {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  nameSw    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  school  School        @relation(fields: [schoolId], references: [id])
  classes SchoolClass[]

  @@unique([schoolId, name])
  @@map("academic_levels")
}

model SchoolClass {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @db.Uuid
  levelId   String   @db.Uuid
  name      String
  nameSw    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  school          School              @relation(fields: [schoolId], references: [id])
  level           AcademicLevel       @relation(fields: [levelId], references: [id])
  streams         Stream[]
  subjects        ClassSubject[]
  enrollments     StudentEnrollment[]
  classTeachers   ClassTeacher[]
  subjectTeachers SubjectTeacher[]

  @@unique([schoolId, name])
  @@index([levelId])
  @@map("classes")
}

model Stream {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @db.Uuid
  classId   String   @db.Uuid
  name      String
  createdAt DateTime @default(now())

  school          School              @relation(fields: [schoolId], references: [id])
  class           SchoolClass         @relation(fields: [classId], references: [id])
  enrollments     StudentEnrollment[]
  classTeachers   ClassTeacher[]
  subjectTeachers SubjectTeacher[]

  @@unique([classId, name])
  @@map("streams")
}

model Subject {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @db.Uuid
  code      String
  name      String
  nameSw    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  school          School           @relation(fields: [schoolId], references: [id])
  classSubjects   ClassSubject[]
  subjectTeachers SubjectTeacher[]

  @@unique([schoolId, code])
  @@map("subjects")
}

model ClassSubject {
  id           String  @id @default(uuid(7)) @db.Uuid
  schoolId     String  @db.Uuid
  classId      String  @db.Uuid
  subjectId    String  @db.Uuid
  isCompulsory Boolean @default(true)

  school  School      @relation(fields: [schoolId], references: [id])
  class   SchoolClass @relation(fields: [classId], references: [id])
  subject Subject     @relation(fields: [subjectId], references: [id])

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

// One class teacher per class/stream per year (uniqueness enforced in migration SQL
// with NULLS NOT DISTINCT because streamId is optional).
model ClassTeacher {
  id             String   @id @default(uuid(7)) @db.Uuid
  schoolId       String   @db.Uuid
  academicYearId String   @db.Uuid
  classId        String   @db.Uuid
  streamId       String?  @db.Uuid
  staffId        String   @db.Uuid
  createdAt      DateTime @default(now())

  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        SchoolClass  @relation(fields: [classId], references: [id])
  stream       Stream?      @relation(fields: [streamId], references: [id])
  staff        Staff        @relation(fields: [staffId], references: [id])

  // Real index is NULLS NOT DISTINCT (see migration SQL); declared here so Prisma does not drop it.
  @@unique([academicYearId, classId, streamId], map: "class_teachers_unique_assignment")
  @@index([staffId, academicYearId])
  @@map("class_teachers")
}

model SubjectTeacher {
  id             String   @id @default(uuid(7)) @db.Uuid
  schoolId       String   @db.Uuid
  academicYearId String   @db.Uuid
  classId        String   @db.Uuid
  streamId       String?  @db.Uuid
  subjectId      String   @db.Uuid
  staffId        String   @db.Uuid
  createdAt      DateTime @default(now())

  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        SchoolClass  @relation(fields: [classId], references: [id])
  stream       Stream?      @relation(fields: [streamId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])
  staff        Staff        @relation(fields: [staffId], references: [id])

  // Real index is NULLS NOT DISTINCT (see migration SQL); declared here so Prisma does not drop it.
  @@unique([academicYearId, classId, streamId, subjectId, staffId], map: "subject_teachers_unique_assignment")
  @@index([staffId, academicYearId])
  @@map("subject_teachers")
}

// ───────────────────────── Students & guardians ─────────────────────────

model AdmissionCounter {
  schoolId  String @db.Uuid
  scope     String // e.g. "2026" when numbering resets per year, "ALL" otherwise
  lastValue Int    @default(0)

  school School @relation(fields: [schoolId], references: [id])

  @@id([schoolId, scope])
  @@map("admission_counters")
}

model Student {
  id                 String        @id @default(uuid(7)) @db.Uuid
  schoolId           String        @db.Uuid
  admissionNo        String
  firstName          String
  middleName         String?
  lastName           String
  dateOfBirth        DateTime      @db.Date
  gender             Gender
  status             StudentStatus @default(ENROLLED)
  admissionDate      DateTime      @db.Date
  nationality        String?
  religion           String?
  birthCertificateNo String?
  previousSchool     String?
  address            String?
  medicalNotes       String? // restricted: student.medical.* permissions
  exitedOn           DateTime?     @db.Date
  exitReason         String?
  createdById        String?       @db.Uuid
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  school            School                 @relation(fields: [schoolId], references: [id])
  guardians         StudentGuardian[]
  enrollments       StudentEnrollment[]
  emergencyContacts EmergencyContact[]
  statusHistory     StudentStatusHistory[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId, status])
  @@index([schoolId, lastName, firstName])
  @@index([schoolId, dateOfBirth])
  @@map("students")
}

model EmergencyContact {
  id           String @id @default(uuid(7)) @db.Uuid
  schoolId     String @db.Uuid
  studentId    String @db.Uuid
  name         String
  relationship String
  phone        String
  sortOrder    Int    @default(0)

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("emergency_contacts")
}

model Guardian {
  id         String   @id @default(uuid(7)) @db.Uuid
  schoolId   String   @db.Uuid
  userId     String?  @unique @db.Uuid // portal account, linked explicitly (never by phone match)
  fullName   String
  phone      String
  altPhone   String?
  email      String?
  occupation String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school   School            @relation(fields: [schoolId], references: [id])
  user     User?             @relation(fields: [userId], references: [id])
  students StudentGuardian[]

  @@index([schoolId, phone])
  @@index([schoolId, fullName])
  @@map("guardians")
}

model StudentGuardian {
  studentId                String               @db.Uuid
  guardianId               String               @db.Uuid
  schoolId                 String               @db.Uuid
  relationship             GuardianRelationship
  isPrimary                Boolean              @default(false)
  receivesNotifications    Boolean              @default(true)
  isFinanciallyResponsible Boolean              @default(false)
  verifiedAt               DateTime?
  verifiedById             String?              @db.Uuid
  createdAt                DateTime             @default(now())

  school   School   @relation(fields: [schoolId], references: [id])
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@id([studentId, guardianId])
  @@index([guardianId])
  @@map("student_guardians")
}

// Enrollment per academic year. History is never overwritten: moves and
// year-end transitions close the old row and open a new one.
model StudentEnrollment {
  id             String           @id @default(uuid(7)) @db.Uuid
  schoolId       String           @db.Uuid
  studentId      String           @db.Uuid
  academicYearId String           @db.Uuid
  classId        String           @db.Uuid
  streamId       String?          @db.Uuid
  status         EnrollmentStatus @default(ACTIVE)
  startedOn      DateTime         @db.Date
  endedOn        DateTime?        @db.Date
  notes          String?
  createdById    String?          @db.Uuid
  createdAt      DateTime         @default(now())

  school       School       @relation(fields: [schoolId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        SchoolClass  @relation(fields: [classId], references: [id])
  stream       Stream?      @relation(fields: [streamId], references: [id])

  @@index([schoolId, academicYearId, classId, streamId, status])
  @@index([studentId])
  @@map("student_enrollments")
}

model StudentStatusHistory {
  id          String        @id @default(uuid(7)) @db.Uuid
  schoolId    String        @db.Uuid
  studentId   String        @db.Uuid
  fromStatus  StudentStatus
  toStatus    StudentStatus
  reason      String
  effectiveOn DateTime      @db.Date
  changedById String        @db.Uuid
  createdAt   DateTime      @default(now())

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_status_history")
}

// ═════════════════════════ Phase 2: Attendance ═════════════════════════

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum RegisterStatus {
  DRAFT
  FINALISED
}

enum OperationKind {
  SAVE_DRAFT
  FINALISE
}

enum OperationOutcome {
  APPLIED
  CONFLICT
}

enum ConflictResolution {
  PENDING
  ACCEPTED
  DISMISSED
}

// Sessions a school records attendance for (e.g. DAY, or Morning/Afternoon/periods).
// school_settings.attendance.mode decides whether only the default DAY session is used.
model AttendanceSession {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @db.Uuid
  code      String
  name      String
  nameSw    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  school    School               @relation(fields: [schoolId], references: [id])
  registers AttendanceRegister[]
  records   StudentAttendance[]

  @@unique([schoolId, code])
  @@map("attendance_sessions")
}

// One register per class/stream/session/date. Holds the draft/finalised state;
// StudentAttendance rows belong to it. Finalised registers change only through corrections.
model AttendanceRegister {
  id             String         @id @default(uuid(7)) @db.Uuid
  schoolId       String         @db.Uuid
  academicYearId String         @db.Uuid
  classId        String         @db.Uuid
  streamId       String?        @db.Uuid
  sessionId      String         @db.Uuid
  date           DateTime       @db.Date
  status         RegisterStatus @default(DRAFT)
  startedById    String         @db.Uuid
  finalisedById  String?        @db.Uuid
  finalisedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  school  School              @relation(fields: [schoolId], references: [id])
  session AttendanceSession   @relation(fields: [sessionId], references: [id])
  records StudentAttendance[]

  // Real index is NULLS NOT DISTINCT (see migration SQL); declared here so Prisma does not drop it.
  @@unique([classId, streamId, sessionId, date], map: "attendance_registers_unique_register")
  @@index([schoolId, date])
  @@index([schoolId, classId, date])
  @@map("attendance_registers")
}

// One status per student per session per day (uniqueness is stronger than student+class+date+session:
// a student who changes class mid-day can never hold two statuses for the same session).
model StudentAttendance {
  id         String           @id @default(uuid(7)) @db.Uuid
  schoolId   String           @db.Uuid
  registerId String           @db.Uuid
  studentId  String           @db.Uuid
  classId    String           @db.Uuid
  streamId   String?          @db.Uuid
  sessionId  String           @db.Uuid
  date       DateTime         @db.Date
  status     AttendanceStatus
  note       String?
  markedById String           @db.Uuid
  markedAt   DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  school      School                 @relation(fields: [schoolId], references: [id])
  register    AttendanceRegister     @relation(fields: [registerId], references: [id])
  session     AttendanceSession      @relation(fields: [sessionId], references: [id])
  corrections AttendanceCorrection[]

  @@unique([studentId, sessionId, date])
  @@index([registerId])
  @@index([schoolId, classId, date])
  @@index([schoolId, studentId, date])
  @@map("student_attendance")
}

// Every change to a finalised record: who, why, from/to. Never edited or deleted.
model AttendanceCorrection {
  id            String           @id @default(uuid(7)) @db.Uuid
  schoolId      String           @db.Uuid
  attendanceId  String           @db.Uuid
  studentId     String           @db.Uuid
  fromStatus    AttendanceStatus
  toStatus      AttendanceStatus
  reason        String
  correctedById String           @db.Uuid
  operationId   String?          @db.Uuid // set when the correction came from resolving a sync conflict
  createdAt     DateTime         @default(now())

  school     School            @relation(fields: [schoolId], references: [id])
  attendance StudentAttendance @relation(fields: [attendanceId], references: [id])

  @@index([attendanceId])
  @@index([schoolId, createdAt])
  @@map("attendance_corrections")
}

// Idempotency ledger + conflict inbox for attendance submissions (online and offline sync).
// (schoolId, userId, clientOpId) is unique: a replay returns the stored outcome and changes nothing.
model AttendanceOperation {
  id               String              @id @default(uuid(7)) @db.Uuid
  schoolId         String              @db.Uuid
  userId           String              @db.Uuid
  clientOpId       String              @db.Uuid
  deviceId         String?
  kind             OperationKind
  classId          String              @db.Uuid
  streamId         String?             @db.Uuid
  sessionId        String              @db.Uuid
  date             DateTime            @db.Date
  payload          Json
  outcome          OperationOutcome
  outcomeCode      String
  registerId       String?             @db.Uuid
  clientCreatedAt  DateTime?
  receivedAt       DateTime            @default(now())
  resolution       ConflictResolution?
  resolvedById     String?             @db.Uuid
  resolvedAt       DateTime?
  resolutionReason String?

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, userId, clientOpId])
  @@index([schoolId, outcome, resolution])
  @@index([registerId])
  @@map("attendance_operations")
}

model StaffAttendance {
  id           String           @id @default(uuid(7)) @db.Uuid
  schoolId     String           @db.Uuid
  staffId      String           @db.Uuid
  date         DateTime         @db.Date
  status       AttendanceStatus
  note         String?
  recordedById String           @db.Uuid
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([staffId, date])
  @@index([schoolId, date])
  @@map("staff_attendance")
}

// ═════════════════════════ Phase 2: Notifications ═════════════════════════

enum NotificationEventType {
  ABSENCE
}

enum NotificationEventStatus {
  PENDING
  PROCESSED
  CANCELLED
  FAILED
}

enum NotificationChannel {
  IN_APP
  SMS
}

// QUEUED/SUBMITTED/DELIVERED/FAILED/UNKNOWN follow the SMS lifecycle (submitted != delivered).
// STORED = saved in the recipient's in-app inbox (not necessarily seen). SKIPPED = channel unavailable.
enum DeliveryStatus {
  QUEUED
  SUBMITTED
  DELIVERED
  FAILED
  UNKNOWN
  SKIPPED
  STORED
}

// Durable domain event: one per (guardian, student, date, session) for an absence. dedupeKey makes
// creation idempotent across edits, corrections and sync retries.
model NotificationEvent {
  id            String                  @id @default(uuid(7)) @db.Uuid
  schoolId      String                  @db.Uuid
  type          NotificationEventType
  dedupeKey     String
  studentId     String                  @db.Uuid
  guardianId    String                  @db.Uuid
  attendanceId  String?                 @db.Uuid
  payload       Json
  status        NotificationEventStatus @default(PENDING)
  attempts      Int                     @default(0)
  lastError     String?
  nextAttemptAt DateTime                @default(now())
  processedAt   DateTime?
  createdAt     DateTime                @default(now())

  school     School                 @relation(fields: [schoolId], references: [id])
  deliveries NotificationDelivery[]
  inApp      InAppNotification?

  @@unique([schoolId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([schoolId, createdAt])
  @@map("notification_events")
}

model NotificationDelivery {
  id          String              @id @default(uuid(7)) @db.Uuid
  schoolId    String              @db.Uuid
  eventId     String              @db.Uuid
  channel     NotificationChannel
  status      DeliveryStatus
  providerRef String?
  detail      String?
  attempts    Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  school School            @relation(fields: [schoolId], references: [id])
  event  NotificationEvent @relation(fields: [eventId], references: [id])

  @@unique([eventId, channel])
  @@map("notification_deliveries")
}

model InAppNotification {
  id        String    @id @default(uuid(7)) @db.Uuid
  schoolId  String    @db.Uuid
  eventId   String    @unique @db.Uuid
  userId    String    @db.Uuid
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  school School            @relation(fields: [schoolId], references: [id])
  event  NotificationEvent @relation(fields: [eventId], references: [id])

  @@index([userId, readAt])
  @@map("in_app_notifications")
}

// ═════════════════════════ Phase 2: Admissions ═════════════════════════

enum ApplicationSource {
  STAFF
  ONLINE
}

enum ApplicationStatus {
  APPLIED
  INTERVIEW
  ACCEPTED
  ENROLLED
  REJECTED
  WITHDRAWN
}

// Accepted != enrolled: the Student record (and admission number) exist only after the enrol step.
// Open-duplicate rules (partial unique indexes on name+DOB and birth certificate) are in the migration SQL.
model Application {
  id                 String            @id @default(uuid(7)) @db.Uuid
  schoolId           String            @db.Uuid
  applicationNo      String
  status             ApplicationStatus @default(APPLIED)
  firstName          String
  middleName         String?
  lastName           String
  dateOfBirth        DateTime          @db.Date
  gender             Gender
  intakeYearId       String?           @db.Uuid
  classAppliedId     String?           @db.Uuid
  nationality        String?
  religion           String?
  birthCertificateNo String?
  previousSchool     String?
  address            String?
  guardians          Json // validated list: [{fullName, phone, relationship, ...}]
  interviewOn        DateTime?         @db.Date
  assessmentNotes    String?
  decisionReason     String?
  decidedAt          DateTime?
  decidedById        String?           @db.Uuid
  studentId          String?           @unique @db.Uuid
  source             ApplicationSource @default(STAFF)
  consentAt          DateTime? // online applicants confirm the data-processing notice
  createdById        String?           @db.Uuid // null for online applications
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  school    School             @relation(fields: [schoolId], references: [id])
  events    ApplicationEvent[]
  documents Document[]

  @@unique([schoolId, applicationNo])
  @@index([schoolId, status])
  @@index([schoolId, lastName, firstName])
  @@map("applications")
}

model ApplicationEvent {
  id            String             @id @default(uuid(7)) @db.Uuid
  schoolId      String             @db.Uuid
  applicationId String             @db.Uuid
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  reason        String?
  byUserId      String?            @db.Uuid // null when the applicant submitted online
  createdAt     DateTime           @default(now())

  school      School      @relation(fields: [schoolId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
  @@map("application_events")
}

// Uploaded files. The bytes live in the storage adapter under an unguessable key; downloads
// always go through a permission-checked, audited route.
model Document {
  id            String    @id @default(uuid(7)) @db.Uuid
  schoolId      String    @db.Uuid
  applicationId String?   @db.Uuid
  studentId     String?   @db.Uuid
  docType       String
  fileName      String
  mimeType      String
  sizeBytes     Int
  sha256        String
  storageKey    String    @unique
  uploadedById  String    @db.Uuid
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  deletedById   String?   @db.Uuid

  school      School       @relation(fields: [schoolId], references: [id])
  application Application? @relation(fields: [applicationId], references: [id])

  @@index([schoolId, applicationId])
  @@index([schoolId, studentId])
  @@map("documents")
}

// ═════════════════════════ Phase 2: Bulk import ═════════════════════════

enum ImportBatchStatus {
  PREVIEW
  IMPORTED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  VALID
  WARNING
  ERROR
  DUPLICATE
  IMPORTED
  SKIPPED
}

model ImportBatch {
  id          String            @id @default(uuid(7)) @db.Uuid
  schoolId    String            @db.Uuid
  createdById String            @db.Uuid
  fileName    String
  status      ImportBatchStatus @default(PREVIEW)
  headerMap   Json
  summary     Json
  createdAt   DateTime          @default(now())
  confirmedAt DateTime?

  school School      @relation(fields: [schoolId], references: [id])
  rows   ImportRow[]

  @@index([schoolId, createdAt])
  @@map("import_batches")
}

model ImportRow {
  id        String          @id @default(uuid(7)) @db.Uuid
  schoolId  String          @db.Uuid
  batchId   String          @db.Uuid
  rowNumber Int
  raw       Json
  status    ImportRowStatus
  messages  Json
  studentId String?         @db.Uuid

  school School      @relation(fields: [schoolId], references: [id])
  batch  ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNumber])
  @@map("import_rows")
}

// ═════════════════════════ Public website ═════════════════════════

// News shown on the public website (and later the portals/communication module).
// publishedAt = null means draft. Only isPublic + published posts are visible to the public.
model Announcement {
  id          String    @id @default(uuid(7)) @db.Uuid
  schoolId    String    @db.Uuid
  title       String
  titleSw     String?
  body        String
  slug        String?
  category    String?
  excerpt     String?
  coverImage  String? // image reference: /site/... (bundled) or /media/<id> (uploaded)
  showInBar   Boolean   @default(false) // appears in the public announcement bar while published
  barLink     String?
  bodySw      String?
  isPublic    Boolean   @default(true)
  publishedAt DateTime?
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, slug])
  @@index([schoolId, publishedAt])
  @@map("announcements")
}

model SchoolEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  schoolId      String    @db.Uuid
  title         String
  titleSw       String?
  description   String?
  descriptionSw String?
  location      String?
  category      String?
  coverImage    String?
  startsOn      DateTime  @db.Date
  endsOn        DateTime? @db.Date
  isPublic      Boolean   @default(true)
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, startsOn])
  @@map("school_events")
}

// Generic sliding-window counter for public endpoints (applications, status checks). No Redis needed.
model RateLimitEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_events")
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

// Messages from the public contact form. Saved first, then handled by staff (never just "success on screen").
model Enquiry {
  id           String        @id @default(uuid(7)) @db.Uuid
  schoolId     String        @db.Uuid
  name         String
  phone        String?
  email        String?
  topic        String? // e.g. admissions, general
  message      String
  status       EnquiryStatus @default(NEW)
  consentAt    DateTime
  internalNote String?
  handledById  String?       @db.Uuid
  handledAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, status, createdAt])
  @@map("enquiries")
}

// Images uploaded by staff for the public website (logo, hero, gallery, news covers). Public by design:
// only put images here that the school is allowed to publish. Served by /media/<id> with long cache headers.
model MediaAsset {
  id          String   @id @default(uuid(7)) @db.Uuid
  schoolId    String   @db.Uuid
  fileName    String
  mimeType    String
  sizeBytes   Int
  width       Int
  height      Int
  alt         String
  bytes       Bytes
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, createdAt])
  @@map("media_assets")
}

// ═════════════════════════ Phase 3: Examinations & results ═════════════════════════

enum ExamCategory {
  MONTHLY
  MIDTERM
  TERMINAL
  ANNUAL
  OTHER
}

enum MarkStatus {
  SCORED
  ABSENT
  EXEMPT
}

// Draft -> Submitted -> Approved -> Locked. RETURNED = sent back for correction (also the state after an audited unlock).
enum SubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  LOCKED
  RETURNED
}

// Configurable grading. Nothing is hard-coded: bands, points and divisions belong to a scale the school owns.
model GradingScale {
  id            String   @id @default(uuid(7)) @db.Uuid
  schoolId      String   @db.Uuid
  name          String
  levelId       String?  @db.Uuid // applies to this academic level; null = any level
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  passMark      Decimal? @db.Decimal(5, 2)
  divisionBestN Int? // division = sum of the best N subject points
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school    School         @relation(fields: [schoolId], references: [id])
  bands     GradeBand[]
  divisions DivisionRule[]

  @@unique([schoolId, name])
  @@map("grading_scales")
}

model GradeBand {
  id         String  @id @default(uuid(7)) @db.Uuid
  scaleId    String  @db.Uuid
  grade      String
  minPercent Decimal @db.Decimal(5, 2)
  maxPercent Decimal @db.Decimal(5, 2)
  points     Int?
  remark     String?
  sortOrder  Int     @default(0)

  scale GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, grade])
  @@map("grade_bands")
}

model DivisionRule {
  id        String @id @default(uuid(7)) @db.Uuid
  scaleId   String @db.Uuid
  division  String
  minPoints Int
  maxPoints Int
  sortOrder Int    @default(0)

  scale GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, division])
  @@map("division_rules")
}

model Exam {
  id                 String       @id @default(uuid(7)) @db.Uuid
  schoolId           String       @db.Uuid
  academicYearId     String       @db.Uuid
  termId             String       @db.Uuid
  name               String
  category           ExamCategory @default(TERMINAL)
  examDate           DateTime?    @db.Date
  maxMarks           Decimal      @default(100) @db.Decimal(6, 2)
  weight             Decimal      @default(100) @db.Decimal(5, 2) // share of the term subject result
  submissionDeadline DateTime?    @db.Date
  gradingScaleId     String?      @db.Uuid
  createdById        String       @db.Uuid
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  school   School        @relation(fields: [schoolId], references: [id])
  subjects ExamSubject[]

  @@unique([schoolId, termId, name])
  @@index([schoolId, termId])
  @@map("exams")
}

// A subject examined for one class in one exam; marks are entered against it.
model ExamSubject {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @db.Uuid
  examId    String   @db.Uuid
  classId   String   @db.Uuid
  subjectId String   @db.Uuid
  maxMarks  Decimal  @db.Decimal(6, 2)
  createdAt DateTime @default(now())

  school      School             @relation(fields: [schoolId], references: [id])
  exam        Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  submissions ResultSubmission[]
  marks       Mark[]

  @@unique([examId, classId, subjectId])
  @@index([schoolId, classId])
  @@map("exam_subjects")
}

// The unit teachers submit and approvers review: one per exam-subject and stream (stream null = whole class).
// Uniqueness (NULLS NOT DISTINCT) is in migration SQL and declared here only so Prisma does not drop it.
model ResultSubmission {
  id            String           @id @default(uuid(7)) @db.Uuid
  schoolId      String           @db.Uuid
  examSubjectId String           @db.Uuid
  streamId      String?          @db.Uuid
  status        SubmissionStatus @default(DRAFT)
  submittedById String?          @db.Uuid
  submittedAt   DateTime?
  returnReason  String?
  approvedById  String?          @db.Uuid
  approvedAt    DateTime?
  lockedById    String?          @db.Uuid
  lockedAt      DateTime?
  unlockedById  String?          @db.Uuid
  unlockedAt    DateTime?
  unlockReason  String?
  version       Int              @default(1)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  school      School      @relation(fields: [schoolId], references: [id])
  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)

  @@unique([examSubjectId, streamId], map: "result_submissions_unit_unique")
  @@index([schoolId, status])
  @@map("result_submissions")
}

// A missing row means "not entered yet". Absent and exempt are explicit states, never silently zero.
model Mark {
  id            String     @id @default(uuid(7)) @db.Uuid
  schoolId      String     @db.Uuid
  examSubjectId String     @db.Uuid
  studentId     String     @db.Uuid
  status        MarkStatus
  score         Decimal?   @db.Decimal(6, 2)
  enteredById   String     @db.Uuid
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  // Snapshot written when the result is locked, so later scale edits never change a locked result.
  lockedPercent Decimal?   @db.Decimal(5, 2)
  lockedGrade   String?
  lockedPoints  Int?
  lockedScaleId String?    @db.Uuid

  school      School      @relation(fields: [schoolId], references: [id])
  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)

  @@unique([examSubjectId, studentId])
  @@index([schoolId, studentId])
  @@map("marks")
}

// Append-only trail of every change made after marks were first submitted.
model ResultChange {
  id            String      @id @default(uuid(7)) @db.Uuid
  schoolId      String      @db.Uuid
  examSubjectId String      @db.Uuid
  studentId     String      @db.Uuid
  oldStatus     MarkStatus?
  oldScore      Decimal?    @db.Decimal(6, 2)
  newStatus     MarkStatus?
  newScore      Decimal?    @db.Decimal(6, 2)
  reason        String?
  changedById   String      @db.Uuid
  createdAt     DateTime    @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, examSubjectId, studentId])
  @@map("result_changes")
}
