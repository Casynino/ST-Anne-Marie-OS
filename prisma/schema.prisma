// St Anne Marie Schools — Phase 1 (Foundation) + Phase 2 (Admissions & Attendance) schema.
// Conventions:
//  * Every school-owned row carries schoolId; services always filter by it.
//  * Calendar dates (dob, term dates, admission date) use @db.Date; timestamps are UTC.
//  * Extra integrity rules that Prisma cannot express (partial unique indexes,
//    CHECK constraints, append-only audit log) live in the migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Locale {
  EN
  SW
}

enum UserType {
  STAFF
  GUARDIAN
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ENROLLED
  TRANSFERRED
  WITHDRAWN
  GRADUATED
}

enum EnrollmentStatus {
  ACTIVE
  MOVED
  COMPLETED
  TRANSFERRED_OUT
  WITHDRAWN
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GRANDPARENT
  UNCLE
  AUNT
  SIBLING
  GUARDIAN
  OTHER
}

// ───────────────────────── Tenancy ─────────────────────────

model School {
  id            String   @id @default(uuid(7)) @db.Uuid
  code          String   @unique
  name          String
  motto         String?
  logoUrl       String?
  email         String?
  phone         String?
  address       String?
  timezone      String   @default("Africa/Dar_es_Salaam")
  currency      String   @default("TZS")
  defaultLocale Locale   @default(EN)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branches               Branch[]
  users                  User[]
  roles                  Role[]
  staff                  Staff[]
  settings               SchoolSetting[]
  auditLogs              AuditLog[]
  academicYears          AcademicYear[]
  terms                  Term[]
  levels                 AcademicLevel[]
  classes                SchoolClass[]
  streams                Stream[]
  subjects               Subject[]
  classSubjects          ClassSubject[]
  classTeachers          ClassTeacher[]
  subjectTeachers        SubjectTeacher[]
  students               Student[]
  guardians              Guardian[]
  studentGuardians       StudentGuardian[]
  enrollments            StudentEnrollment[]
  emergencyContacts      EmergencyContact[]
  statusHistory          StudentStatusHistory[]
  admissionCounters      AdmissionCounter[]
  attendanceSessions     AttendanceSession[]
  attendanceRegisters    AttendanceRegister[]
  studentAttendance      StudentAttendance[]
  attendanceCorrections  AttendanceCorrection[]
  attendanceOperations   AttendanceOperation[]
  staffAttendance        StaffAttendance[]
  notificationEvents     NotificationEvent[]
  notificationDeliveries NotificationDelivery[]
  inAppNotifications     InAppNotification[]
  applications           Application[]
  applicationEvents      ApplicationEvent[]
  documents              Document[]
  importBatches          ImportBatch[]
  importRows             ImportRow[]
  announcements          Announcement[]
  events                 SchoolEvent[]
  enquiries              Enquiry[]
  mediaAssets            MediaAsset[]
  gradingScales          GradingScale[]
  exams                  Exam[]
  examSubjects           ExamSubject[]
  resultSubmissions      ResultSubmission[]
  marks                  Mark[]
  resultChanges          ResultChange[]
  reportRemarks          ReportRemark[]
  reportCards            ReportCard[]
  feeItems               FeeItem[]
  feeStructures          FeeStructure[]
  studentDiscounts       StudentDiscount[]
  invoices               Invoice[]
  payments               Payment[]
  receipts               Receipt[]
  refunds                Refund[]
  expenseCategories      ExpenseCategory[]
  expenses               Expense[]
  paymentEvents          PaymentEvent[]
  broadcasts             Broadcast[]
  messageTemplates       MessageTemplate[]
  messageThreads         MessageThread[]
  timetablePeriods       TimetablePeriod[]
  timetableEntries       TimetableEntry[]
  schemesOfWork          SchemeOfWork[]
  lessonPlans            LessonPlan[]
  assignments            Assignment[]
  assignmentSubmissions  AssignmentSubmission[]
  learningFiles          LearningFile[]
  portfolioItems         PortfolioItem[]
  behaviourRecords       BehaviourRecord[]
  interviews             Interview[]
  admissionOffers        AdmissionOffer[]
  admissionPayments      AdmissionPayment[]

  @@map("schools")
}

model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  code      String
  address   String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])
  users  User[]

  @@unique([schoolId, code])
  @@map("branches")
}

model SchoolSetting {
  id          String   @id @default(uuid(7)) @db.Uuid
  schoolId    String   @db.Uuid
  key         String
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, key])
  @@map("school_settings")
}

// ───────────────────────── Identity & access ─────────────────────────

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  schoolId           String     @db.Uuid
  branchId           String?    @db.Uuid
  type               UserType   @default(STAFF)
  fullName           String
  email              String?    @unique // stored lowercase
  phone              String?    @unique // stored as +255XXXXXXXXX
  passwordHash       String
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true)
  locale             Locale     @default(EN)
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  school   School     @relation(fields: [schoolId], references: [id])
  branch   Branch?    @relation(fields: [branchId], references: [id])
  roles    UserRole[]
  sessions Session[]
  staff    Staff?
  guardian Guardian?
  student  Student?

  @@index([schoolId, type])
  @@map("users")
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginAttempt {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  ip         String?
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  schoolId    String   @db.Uuid
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  school      School           @relation(fields: [schoolId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([schoolId, key])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  key         String  @unique
  module      String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String   @db.Uuid
  roleId       String   @db.Uuid
  assignedAt   DateTime @default(now())
  assignedById String?  @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Staff {
  id         String    @id @default(uuid(7)) @db.Uuid
  schoolId   String    @db.Uuid
  userId     String    @unique @db.Uuid
  staffNo    String?
  jobTitle   String?
  employedOn DateTime? @db.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  school           School           @relation(fields: [schoolId], references: [id])
  user             User             @relation(fields: [userId], references: [id])
  classTeacherOf   ClassTeacher[]
  subjectTeacherOf SubjectTeacher[]

  @@unique([schoolId, staffNo])
  @@map("staff")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  schoolId   String   @db.Uuid
  actorId    String?  @db.Uuid
  actorName  String?
  action     String
  entityType String
  entityId   String?
  summary    String?
  changes    Json?
  reason     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, createdAt])
  @@index([schoolId, entityType, entityId])
  @@index([schoolId, actorId])
  @@map("audit_logs")
}

// ───────────────────────── Academic structure ─────────────────────────

model AcademicYear {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school          School              @relation(fields: [schoolId], references: [id])
  terms           Term[]
  enrollments     StudentEnrollment[]
  classTeachers   ClassTeacher[]
  subjectTeachers SubjectTeacher[]

  @@unique([schoolId, name])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(uuid(7)) @db.Uuid
  schoolId       String   @db.Uuid
  academicYearId String   @db.Uuid
  name           String
  sequence       Int
  startsOn       DateTime @db.Date
  endsOn         DateTime @db.Date
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([academicYearId, sequence])
  @@unique([academicYearId, name])
  @@map("terms")
}

model AcademicLevel {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  nameSw    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  school  School        @relation(fields: [schoolId], references: [id])
  classes SchoolClass[]

  @@unique([schoolId, name])
  @@map("academic_levels")
}

model SchoolClass {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @db.Uuid
  levelId   String   @db.Uuid
  name      String
  nameSw    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  capacity  Int? // maximum active students in the current year; null = no limit
  createdAt DateTime @default(now())

  school          School              @relation(fields: [schoolId], references: [id])
  level           AcademicLevel       @relation(fields: [levelId], references: [id])
  streams         Stream[]
  subjects        ClassSubject[]
  enrollments     StudentEnrollment[]
  classTeachers   ClassTeacher[]
  subjectTeachers SubjectTeacher[]

  @@unique([schoolId, name])
  @@index([levelId])
  @@map("classes")
}

model Stream {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @db.Uuid
  classId   String   @db.Uuid
  name      String
  createdAt DateTime @default(now())

  school          School              @relation(fields: [schoolId], references: [id])
  class           SchoolClass         @relation(fields: [classId], references: [id])
  enrollments     StudentEnrollment[]
  classTeachers   ClassTeacher[]
  subjectTeachers SubjectTeacher[]

  @@unique([classId, name])
  @@map("streams")
}

model Subject {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @db.Uuid
  code      String
  name      String
  nameSw    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  school          School           @relation(fields: [schoolId], references: [id])
  classSubjects   ClassSubject[]
  subjectTeachers SubjectTeacher[]

  @@unique([schoolId, code])
  @@map("subjects")
}

model ClassSubject {
  id           String  @id @default(uuid(7)) @db.Uuid
  schoolId     String  @db.Uuid
  classId      String  @db.Uuid
  subjectId    String  @db.Uuid
  isCompulsory Boolean @default(true)

  school  School      @relation(fields: [schoolId], references: [id])
  class   SchoolClass @relation(fields: [classId], references: [id])
  subject Subject     @relation(fields: [subjectId], references: [id])

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

// One class teacher per class/stream per year (uniqueness enforced in migration SQL
// with NULLS NOT DISTINCT because streamId is optional).
model ClassTeacher {
  id             String   @id @default(uuid(7)) @db.Uuid
  schoolId       String   @db.Uuid
  academicYearId String   @db.Uuid
  classId        String   @db.Uuid
  streamId       String?  @db.Uuid
  staffId        String   @db.Uuid
  createdAt      DateTime @default(now())

  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        SchoolClass  @relation(fields: [classId], references: [id])
  stream       Stream?      @relation(fields: [streamId], references: [id])
  staff        Staff        @relation(fields: [staffId], references: [id])

  // Real index is NULLS NOT DISTINCT (see migration SQL); declared here so Prisma does not drop it.
  @@unique([academicYearId, classId, streamId], map: "class_teachers_unique_assignment")
  @@index([staffId, academicYearId])
  @@map("class_teachers")
}

model SubjectTeacher {
  id             String   @id @default(uuid(7)) @db.Uuid
  schoolId       String   @db.Uuid
  academicYearId String   @db.Uuid
  classId        String   @db.Uuid
  streamId       String?  @db.Uuid
  subjectId      String   @db.Uuid
  staffId        String   @db.Uuid
  createdAt      DateTime @default(now())

  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        SchoolClass  @relation(fields: [classId], references: [id])
  stream       Stream?      @relation(fields: [streamId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])
  staff        Staff        @relation(fields: [staffId], references: [id])

  // Real index is NULLS NOT DISTINCT (see migration SQL); declared here so Prisma does not drop it.
  @@unique([academicYearId, classId, streamId, subjectId, staffId], map: "subject_teachers_unique_assignment")
  @@index([staffId, academicYearId])
  @@map("subject_teachers")
}

// ───────────────────────── Students & guardians ─────────────────────────

model AdmissionCounter {
  schoolId  String @db.Uuid
  scope     String // e.g. "2026" when numbering resets per year, "ALL" otherwise
  lastValue Int    @default(0)

  school School @relation(fields: [schoolId], references: [id])

  @@id([schoolId, scope])
  @@map("admission_counters")
}

model Student {
  id                 String        @id @default(uuid(7)) @db.Uuid
  schoolId           String        @db.Uuid
  admissionNo        String
  firstName          String
  middleName         String?
  lastName           String
  dateOfBirth        DateTime      @db.Date
  gender             Gender
  status             StudentStatus @default(ENROLLED)
  admissionDate      DateTime      @db.Date
  nationality        String?
  religion           String?
  birthCertificateNo String?
  previousSchool     String?
  address            String?
  medicalNotes       String? // restricted: student.medical.* permissions
  exitedOn           DateTime?     @db.Date
  exitReason         String?
  userId             String?       @unique @db.Uuid // student portal account, linked explicitly
  createdById        String?       @db.Uuid
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  school            School                 @relation(fields: [schoolId], references: [id])
  user              User?                  @relation(fields: [userId], references: [id])
  guardians         StudentGuardian[]
  enrollments       StudentEnrollment[]
  emergencyContacts EmergencyContact[]
  statusHistory     StudentStatusHistory[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId, status])
  @@index([schoolId, lastName, firstName])
  @@index([schoolId, dateOfBirth])
  @@map("students")
}

model EmergencyContact {
  id           String @id @default(uuid(7)) @db.Uuid
  schoolId     String @db.Uuid
  studentId    String @db.Uuid
  name         String
  relationship String
  phone        String
  sortOrder    Int    @default(0)

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("emergency_contacts")
}

model Guardian {
  id         String   @id @default(uuid(7)) @db.Uuid
  schoolId   String   @db.Uuid
  userId     String?  @unique @db.Uuid // portal account, linked explicitly (never by phone match)
  fullName   String
  phone      String
  altPhone   String?
  email      String?
  occupation String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school   School            @relation(fields: [schoolId], references: [id])
  user     User?             @relation(fields: [userId], references: [id])
  students StudentGuardian[]

  @@index([schoolId, phone])
  @@index([schoolId, fullName])
  @@map("guardians")
}

model StudentGuardian {
  studentId                String               @db.Uuid
  guardianId               String               @db.Uuid
  schoolId                 String               @db.Uuid
  relationship             GuardianRelationship
  isPrimary                Boolean              @default(false)
  receivesNotifications    Boolean              @default(true)
  isFinanciallyResponsible Boolean              @default(false)
  verifiedAt               DateTime?
  verifiedById             String?              @db.Uuid
  createdAt                DateTime             @default(now())

  school   School   @relation(fields: [schoolId], references: [id])
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@id([studentId, guardianId])
  @@index([guardianId])
  @@map("student_guardians")
}

// Enrollment per academic year. History is never overwritten: moves and
// year-end transitions close the old row and open a new one.
model StudentEnrollment {
  id             String           @id @default(uuid(7)) @db.Uuid
  schoolId       String           @db.Uuid
  studentId      String           @db.Uuid
  academicYearId String           @db.Uuid
  classId        String           @db.Uuid
  streamId       String?          @db.Uuid
  status         EnrollmentStatus @default(ACTIVE)
  startedOn      DateTime         @db.Date
  endedOn        DateTime?        @db.Date
  notes          String?
  createdById    String?          @db.Uuid
  createdAt      DateTime         @default(now())

  school       School       @relation(fields: [schoolId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        SchoolClass  @relation(fields: [classId], references: [id])
  stream       Stream?      @relation(fields: [streamId], references: [id])

  @@index([schoolId, academicYearId, classId, streamId, status])
  @@index([studentId])
  @@map("student_enrollments")
}

model StudentStatusHistory {
  id          String        @id @default(uuid(7)) @db.Uuid
  schoolId    String        @db.Uuid
  studentId   String        @db.Uuid
  fromStatus  StudentStatus
  toStatus    StudentStatus
  reason      String
  effectiveOn DateTime      @db.Date
  changedById String        @db.Uuid
  createdAt   DateTime      @default(now())

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_status_history")
}

// ═════════════════════════ Phase 2: Attendance ═════════════════════════

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum RegisterStatus {
  DRAFT
  FINALISED
}

enum OperationKind {
  SAVE_DRAFT
  FINALISE
}

enum OperationOutcome {
  APPLIED
  CONFLICT
}

enum ConflictResolution {
  PENDING
  ACCEPTED
  DISMISSED
}

// Sessions a school records attendance for (e.g. DAY, or Morning/Afternoon/periods).
// school_settings.attendance.mode decides whether only the default DAY session is used.
model AttendanceSession {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @db.Uuid
  code      String
  name      String
  nameSw    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  school    School               @relation(fields: [schoolId], references: [id])
  registers AttendanceRegister[]
  records   StudentAttendance[]

  @@unique([schoolId, code])
  @@map("attendance_sessions")
}

// One register per class/stream/session/date. Holds the draft/finalised state;
// StudentAttendance rows belong to it. Finalised registers change only through corrections.
model AttendanceRegister {
  id             String         @id @default(uuid(7)) @db.Uuid
  schoolId       String         @db.Uuid
  academicYearId String         @db.Uuid
  classId        String         @db.Uuid
  streamId       String?        @db.Uuid
  sessionId      String         @db.Uuid
  date           DateTime       @db.Date
  status         RegisterStatus @default(DRAFT)
  startedById    String         @db.Uuid
  finalisedById  String?        @db.Uuid
  finalisedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  school  School              @relation(fields: [schoolId], references: [id])
  session AttendanceSession   @relation(fields: [sessionId], references: [id])
  records StudentAttendance[]

  // Real index is NULLS NOT DISTINCT (see migration SQL); declared here so Prisma does not drop it.
  @@unique([classId, streamId, sessionId, date], map: "attendance_registers_unique_register")
  @@index([schoolId, date])
  @@index([schoolId, classId, date])
  @@map("attendance_registers")
}

// One status per student per session per day (uniqueness is stronger than student+class+date+session:
// a student who changes class mid-day can never hold two statuses for the same session).
model StudentAttendance {
  id         String           @id @default(uuid(7)) @db.Uuid
  schoolId   String           @db.Uuid
  registerId String           @db.Uuid
  studentId  String           @db.Uuid
  classId    String           @db.Uuid
  streamId   String?          @db.Uuid
  sessionId  String           @db.Uuid
  date       DateTime         @db.Date
  status     AttendanceStatus
  note       String?
  markedById String           @db.Uuid
  markedAt   DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  school      School                 @relation(fields: [schoolId], references: [id])
  register    AttendanceRegister     @relation(fields: [registerId], references: [id])
  session     AttendanceSession      @relation(fields: [sessionId], references: [id])
  corrections AttendanceCorrection[]

  @@unique([studentId, sessionId, date])
  @@index([registerId])
  @@index([schoolId, classId, date])
  @@index([schoolId, studentId, date])
  @@map("student_attendance")
}

// Every change to a finalised record: who, why, from/to. Never edited or deleted.
model AttendanceCorrection {
  id            String           @id @default(uuid(7)) @db.Uuid
  schoolId      String           @db.Uuid
  attendanceId  String           @db.Uuid
  studentId     String           @db.Uuid
  fromStatus    AttendanceStatus
  toStatus      AttendanceStatus
  reason        String
  correctedById String           @db.Uuid
  operationId   String?          @db.Uuid // set when the correction came from resolving a sync conflict
  createdAt     DateTime         @default(now())

  school     School            @relation(fields: [schoolId], references: [id])
  attendance StudentAttendance @relation(fields: [attendanceId], references: [id])

  @@index([attendanceId])
  @@index([schoolId, createdAt])
  @@map("attendance_corrections")
}

// Idempotency ledger + conflict inbox for attendance submissions (online and offline sync).
// (schoolId, userId, clientOpId) is unique: a replay returns the stored outcome and changes nothing.
model AttendanceOperation {
  id               String              @id @default(uuid(7)) @db.Uuid
  schoolId         String              @db.Uuid
  userId           String              @db.Uuid
  clientOpId       String              @db.Uuid
  deviceId         String?
  kind             OperationKind
  classId          String              @db.Uuid
  streamId         String?             @db.Uuid
  sessionId        String              @db.Uuid
  date             DateTime            @db.Date
  payload          Json
  outcome          OperationOutcome
  outcomeCode      String
  registerId       String?             @db.Uuid
  clientCreatedAt  DateTime?
  receivedAt       DateTime            @default(now())
  resolution       ConflictResolution?
  resolvedById     String?             @db.Uuid
  resolvedAt       DateTime?
  resolutionReason String?

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, userId, clientOpId])
  @@index([schoolId, outcome, resolution])
  @@index([registerId])
  @@map("attendance_operations")
}

model StaffAttendance {
  id           String           @id @default(uuid(7)) @db.Uuid
  schoolId     String           @db.Uuid
  staffId      String           @db.Uuid
  date         DateTime         @db.Date
  status       AttendanceStatus
  note         String?
  recordedById String           @db.Uuid
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([staffId, date])
  @@index([schoolId, date])
  @@map("staff_attendance")
}

// ═════════════════════════ Phase 2: Notifications ═════════════════════════

enum NotificationEventType {
  ABSENCE
  ANNOUNCEMENT // a broadcast notice
  FEE_REMINDER // one per guardian and child, from a fee-reminder broadcast
  RESULTS_READY // a report card was published
}

enum NotificationEventStatus {
  PENDING
  PROCESSED
  CANCELLED
  FAILED
}

enum NotificationChannel {
  IN_APP
  SMS
}

// QUEUED/SUBMITTED/DELIVERED/FAILED/UNKNOWN follow the SMS lifecycle (submitted != delivered).
// STORED = saved in the recipient's in-app inbox (not necessarily seen). SKIPPED = channel unavailable.
enum DeliveryStatus {
  QUEUED
  SUBMITTED
  DELIVERED
  FAILED
  UNKNOWN
  SKIPPED
  STORED
}

// Durable domain event: one per (guardian, student, date, session) for an absence. dedupeKey makes
// creation idempotent across edits, corrections and sync retries.
model NotificationEvent {
  id            String                  @id @default(uuid(7)) @db.Uuid
  schoolId      String                  @db.Uuid
  type          NotificationEventType
  dedupeKey     String
  studentId     String                  @db.Uuid
  guardianId    String                  @db.Uuid
  attendanceId  String?                 @db.Uuid
  broadcastId   String?                 @db.Uuid
  payload       Json
  status        NotificationEventStatus @default(PENDING)
  attempts      Int                     @default(0)
  lastError     String?
  nextAttemptAt DateTime                @default(now())
  processedAt   DateTime?
  createdAt     DateTime                @default(now())

  school     School                 @relation(fields: [schoolId], references: [id])
  broadcast  Broadcast?             @relation(fields: [broadcastId], references: [id])
  deliveries NotificationDelivery[]
  inApp      InAppNotification?

  @@unique([schoolId, dedupeKey])
  @@index([broadcastId])
  @@index([status, nextAttemptAt])
  @@index([schoolId, createdAt])
  @@map("notification_events")
}

model NotificationDelivery {
  id          String              @id @default(uuid(7)) @db.Uuid
  schoolId    String              @db.Uuid
  eventId     String              @db.Uuid
  channel     NotificationChannel
  status      DeliveryStatus
  providerRef String?
  detail      String?
  attempts    Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  school School            @relation(fields: [schoolId], references: [id])
  event  NotificationEvent @relation(fields: [eventId], references: [id])

  @@unique([eventId, channel])
  @@map("notification_deliveries")
}

model InAppNotification {
  id        String    @id @default(uuid(7)) @db.Uuid
  schoolId  String    @db.Uuid
  eventId   String?   @unique @db.Uuid // null for items that do not come from the outbox (e.g. a new message)
  userId    String    @db.Uuid
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  school School             @relation(fields: [schoolId], references: [id])
  event  NotificationEvent? @relation(fields: [eventId], references: [id])

  @@index([userId, readAt])
  @@map("in_app_notifications")
}

// ═════════════════════════ Phase 2: Admissions ═════════════════════════

enum ApplicationSource {
  STAFF
  ONLINE
}

enum ApplicationStatus {
  APPLIED
  INTERVIEW
  ACCEPTED
  ENROLLED
  REJECTED
  WITHDRAWN
}

// Accepted != enrolled: the Student record (and admission number) exist only after the enrol step.
// Open-duplicate rules (partial unique indexes on name+DOB and birth certificate) are in the migration SQL.
model Application {
  id                 String            @id @default(uuid(7)) @db.Uuid
  schoolId           String            @db.Uuid
  applicationNo      String
  status             ApplicationStatus @default(APPLIED)
  firstName          String
  middleName         String?
  lastName           String
  dateOfBirth        DateTime          @db.Date
  gender             Gender
  intakeYearId       String?           @db.Uuid
  classAppliedId     String?           @db.Uuid
  nationality        String?
  religion           String?
  birthCertificateNo String?
  previousSchool     String?
  address            String?
  guardians          Json // validated list: [{fullName, phone, relationship, ...}]
  interviewOn        DateTime?         @db.Date
  assessmentNotes    String?
  decisionReason     String?
  decidedAt          DateTime?
  decidedById        String?           @db.Uuid
  studentId          String?           @unique @db.Uuid
  source             ApplicationSource @default(STAFF)
  consentAt          DateTime? // online applicants confirm the data-processing notice
  createdById        String?           @db.Uuid // null for online applications
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Admissions Office review (separate from the status above): are the details and papers in order?
  submittedOn         DateTime?    @db.Date // the day a paper form was handed in (staff-entered applications)
  reviewStatus        ReviewStatus @default(PENDING)
  reviewNote          String?
  reviewedById        String?      @db.Uuid
  reviewedAt          DateTime?
  // Recorded exception: the papers are not complete but an authorised person lets the application go on.
  docsExceptionReason String?
  docsExceptionById   String?      @db.Uuid
  docsExceptionAt     DateTime?

  school     School             @relation(fields: [schoolId], references: [id])
  events     ApplicationEvent[]
  documents  Document[]
  interviews Interview[]
  offer      AdmissionOffer?
  payments   AdmissionPayment[]

  @@unique([schoolId, applicationNo])
  @@index([schoolId, status])
  @@index([schoolId, lastName, firstName])
  @@map("applications")
}

model ApplicationEvent {
  id            String             @id @default(uuid(7)) @db.Uuid
  schoolId      String             @db.Uuid
  applicationId String             @db.Uuid
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  reason        String?
  byUserId      String?            @db.Uuid // null when the applicant submitted online
  kind          String             @default("STATUS") // STATUS | REVIEW | DOCUMENT | INTERVIEW | OFFER | PAYMENT | EXCEPTION
  createdAt     DateTime           @default(now())

  school      School      @relation(fields: [schoolId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
  @@map("application_events")
}

// Uploaded files. The bytes live in the storage adapter under an unguessable key; downloads
// always go through a permission-checked, audited route.
model Document {
  id            String    @id @default(uuid(7)) @db.Uuid
  schoolId      String    @db.Uuid
  applicationId String?   @db.Uuid
  studentId     String?   @db.Uuid
  docType       String
  fileName      String
  mimeType      String
  sizeBytes     Int
  sha256        String
  storageKey    String    @unique
  uploadedById  String    @db.Uuid
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  deletedById   String?   @db.Uuid

  verification     DocVerification @default(PENDING)
  verifiedById     String?         @db.Uuid
  verifiedAt       DateTime?
  verificationNote String?

  school      School       @relation(fields: [schoolId], references: [id])
  application Application? @relation(fields: [applicationId], references: [id])

  @@index([schoolId, applicationId])
  @@index([schoolId, studentId])
  @@map("documents")
}

// ═════════════════════════ Admissions workflow: review, interviews, offers, admission payments ═════════════════════════

enum ReviewStatus {
  PENDING
  VERIFIED
  RETURNED // sent back to the applicant for correction or more information
}

enum DocVerification {
  PENDING
  VERIFIED
  NEEDS_CORRECTION
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewOutcome {
  PASSED
  NOT_PASSED
  DEFERRED
  FURTHER_ASSESSMENT
  AWAITING_DECISION
}

enum OfferStatus {
  PENDING_APPROVAL
  ISSUED
  DECLINED
  WITHDRAWN
}

enum AdmissionPaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  REVERSED
}

// One row per appointment. A rescheduled interview is cancelled and a new row points back to it (history is kept).
model Interview {
  id                String            @id @default(uuid(7)) @db.Uuid
  schoolId          String            @db.Uuid
  applicationId     String            @db.Uuid
  scheduledAt       DateTime
  durationMinutes   Int               @default(30)
  location          String?
  method            String? // free text, for example "In person" or "Phone"
  interviewerId     String?           @db.Uuid // staff user responsible
  status            InterviewStatus   @default(SCHEDULED)
  outcome           InterviewOutcome?
  score             Int? // optional 0-100
  notes             String? // restricted: needs admission.interview.notes
  scheduleNote      String?
  cancelReason      String?
  rescheduledFromId String?           @db.Uuid
  completedAt       DateTime?
  completedById     String?           @db.Uuid
  createdById       String            @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  school      School      @relation(fields: [schoolId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])

  @@index([schoolId, scheduledAt])
  @@index([applicationId])
  @@index([interviewerId, scheduledAt])
  @@map("interviews")
}

// The decision to admit, with the admission payment required before enrolment. One per application.
model AdmissionOffer {
  id                  String      @id @default(uuid(7)) @db.Uuid
  schoolId            String      @db.Uuid
  applicationId       String      @unique @db.Uuid
  status              OfferStatus @default(ISSUED)
  letterNo            String
  classOfferedId      String?     @db.Uuid
  feeAmount           Decimal     @db.Decimal(14, 2) // required admission payment (0 = none)
  expiresOn           DateTime?   @db.Date
  notes               String? // shown on the letter
  issuedAt            DateTime    @default(now())
  issuedById          String      @db.Uuid
  approvedAt          DateTime?
  approvedById        String?     @db.Uuid
  respondedAt         DateTime?
  responseNote        String?
  // Recorded exception: enrolment may go ahead although the required payment has not been verified.
  paymentWaivedAt     DateTime?
  paymentWaivedById   String?     @db.Uuid
  paymentWaiverReason String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  school      School      @relation(fields: [schoolId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])

  @@unique([schoolId, letterNo])
  @@map("admission_offers")
}

// Money paid by an applicant. It is not part of the student's school-fee ledger (admission fee is separate from recurring fees)
// and counts only after Finance verifies it. Never edited or deleted: reject or reverse with a reason.
model AdmissionPayment {
  id             String                 @id @default(uuid(7)) @db.Uuid
  schoolId       String                 @db.Uuid
  applicationId  String                 @db.Uuid
  amount         Decimal                @db.Decimal(14, 2)
  method         PaymentMethod
  reference      String?
  paidOn         DateTime               @db.Date
  payerName      String?
  notes          String?
  status         AdmissionPaymentStatus @default(PENDING)
  receiptNo      String?
  idempotencyKey String?
  recordedById   String                 @db.Uuid
  recordedAt     DateTime               @default(now())
  verifiedById   String?                @db.Uuid
  verifiedAt     DateTime?
  rejectReason   String?
  reversedById   String?                @db.Uuid
  reversedAt     DateTime?
  reverseReason  String?

  school      School      @relation(fields: [schoolId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])

  @@index([schoolId, status])
  @@index([applicationId])
  @@map("admission_payments")
}

// ═════════════════════════ Phase 2: Bulk import ═════════════════════════

enum ImportBatchStatus {
  PREVIEW
  IMPORTED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  VALID
  WARNING
  ERROR
  DUPLICATE
  IMPORTED
  SKIPPED
}

model ImportBatch {
  id          String            @id @default(uuid(7)) @db.Uuid
  schoolId    String            @db.Uuid
  createdById String            @db.Uuid
  fileName    String
  status      ImportBatchStatus @default(PREVIEW)
  headerMap   Json
  summary     Json
  createdAt   DateTime          @default(now())
  confirmedAt DateTime?

  school School      @relation(fields: [schoolId], references: [id])
  rows   ImportRow[]

  @@index([schoolId, createdAt])
  @@map("import_batches")
}

model ImportRow {
  id        String          @id @default(uuid(7)) @db.Uuid
  schoolId  String          @db.Uuid
  batchId   String          @db.Uuid
  rowNumber Int
  raw       Json
  status    ImportRowStatus
  messages  Json
  studentId String?         @db.Uuid

  school School      @relation(fields: [schoolId], references: [id])
  batch  ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNumber])
  @@map("import_rows")
}

// ═════════════════════════ Public website ═════════════════════════

// News shown on the public website (and later the portals/communication module).
// publishedAt = null means draft. Only isPublic + published posts are visible to the public.
model Announcement {
  id          String    @id @default(uuid(7)) @db.Uuid
  schoolId    String    @db.Uuid
  title       String
  titleSw     String?
  body        String
  slug        String?
  category    String?
  excerpt     String?
  coverImage  String? // image reference: /site/... (bundled) or /media/<id> (uploaded)
  showInBar   Boolean   @default(false) // appears in the public announcement bar while published
  barLink     String?
  bodySw      String?
  isPublic    Boolean   @default(true)
  publishedAt DateTime?
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, slug])
  @@index([schoolId, publishedAt])
  @@map("announcements")
}

model SchoolEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  schoolId      String    @db.Uuid
  title         String
  titleSw       String?
  description   String?
  descriptionSw String?
  location      String?
  category      String?
  coverImage    String?
  startsOn      DateTime  @db.Date
  endsOn        DateTime? @db.Date
  isPublic      Boolean   @default(true)
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, startsOn])
  @@map("school_events")
}

// Generic sliding-window counter for public endpoints (applications, status checks). No Redis needed.
model RateLimitEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_events")
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

// Messages from the public contact form. Saved first, then handled by staff (never just "success on screen").
model Enquiry {
  id           String        @id @default(uuid(7)) @db.Uuid
  schoolId     String        @db.Uuid
  name         String
  phone        String?
  email        String?
  topic        String? // e.g. admissions, general
  message      String
  status       EnquiryStatus @default(NEW)
  consentAt    DateTime
  internalNote String?
  handledById  String?       @db.Uuid
  handledAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, status, createdAt])
  @@map("enquiries")
}

// Images uploaded by staff for the public website (logo, hero, gallery, news covers). Public by design:
// only put images here that the school is allowed to publish. Served by /media/<id> with long cache headers.
model MediaAsset {
  id          String   @id @default(uuid(7)) @db.Uuid
  schoolId    String   @db.Uuid
  fileName    String
  mimeType    String
  sizeBytes   Int
  width       Int
  height      Int
  alt         String
  bytes       Bytes
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, createdAt])
  @@map("media_assets")
}

// ═════════════════════════ Phase 3: Examinations & results ═════════════════════════

enum ExamCategory {
  MONTHLY
  MIDTERM
  TERMINAL
  ANNUAL
  OTHER
}

enum MarkStatus {
  SCORED
  ABSENT
  EXEMPT
}

// Draft -> Submitted -> Approved -> Locked. RETURNED = sent back for correction (also the state after an audited unlock).
enum SubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  LOCKED
  RETURNED
}

// Configurable grading. Nothing is hard-coded: bands, points and divisions belong to a scale the school owns.
model GradingScale {
  id            String   @id @default(uuid(7)) @db.Uuid
  schoolId      String   @db.Uuid
  name          String
  levelId       String?  @db.Uuid // applies to this academic level; null = any level
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  passMark      Decimal? @db.Decimal(5, 2)
  divisionBestN Int? // division = sum of the best N subject points
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school    School         @relation(fields: [schoolId], references: [id])
  bands     GradeBand[]
  divisions DivisionRule[]

  @@unique([schoolId, name])
  @@map("grading_scales")
}

model GradeBand {
  id         String  @id @default(uuid(7)) @db.Uuid
  scaleId    String  @db.Uuid
  grade      String
  minPercent Decimal @db.Decimal(5, 2)
  maxPercent Decimal @db.Decimal(5, 2)
  points     Int?
  remark     String?
  sortOrder  Int     @default(0)

  scale GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, grade])
  @@map("grade_bands")
}

model DivisionRule {
  id        String @id @default(uuid(7)) @db.Uuid
  scaleId   String @db.Uuid
  division  String
  minPoints Int
  maxPoints Int
  sortOrder Int    @default(0)

  scale GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, division])
  @@map("division_rules")
}

model Exam {
  id                 String       @id @default(uuid(7)) @db.Uuid
  schoolId           String       @db.Uuid
  academicYearId     String       @db.Uuid
  termId             String       @db.Uuid
  name               String
  category           ExamCategory @default(TERMINAL)
  examDate           DateTime?    @db.Date
  maxMarks           Decimal      @default(100) @db.Decimal(6, 2)
  weight             Decimal      @default(100) @db.Decimal(5, 2) // share of the term subject result
  submissionDeadline DateTime?    @db.Date
  gradingScaleId     String?      @db.Uuid
  createdById        String       @db.Uuid
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  school   School        @relation(fields: [schoolId], references: [id])
  subjects ExamSubject[]

  @@unique([schoolId, termId, name])
  @@index([schoolId, termId])
  @@map("exams")
}

// A subject examined for one class in one exam; marks are entered against it.
model ExamSubject {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @db.Uuid
  examId    String   @db.Uuid
  classId   String   @db.Uuid
  subjectId String   @db.Uuid
  maxMarks  Decimal  @db.Decimal(6, 2)
  createdAt DateTime @default(now())

  school      School             @relation(fields: [schoolId], references: [id])
  exam        Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  submissions ResultSubmission[]
  marks       Mark[]

  @@unique([examId, classId, subjectId])
  @@index([schoolId, classId])
  @@map("exam_subjects")
}

// The unit teachers submit and approvers review: one per exam-subject and stream (stream null = whole class).
// Uniqueness (NULLS NOT DISTINCT) is in migration SQL and declared here only so Prisma does not drop it.
model ResultSubmission {
  id            String           @id @default(uuid(7)) @db.Uuid
  schoolId      String           @db.Uuid
  examSubjectId String           @db.Uuid
  streamId      String?          @db.Uuid
  status        SubmissionStatus @default(DRAFT)
  submittedById String?          @db.Uuid
  submittedAt   DateTime?
  returnReason  String?
  approvedById  String?          @db.Uuid
  approvedAt    DateTime?
  lockedById    String?          @db.Uuid
  lockedAt      DateTime?
  unlockedById  String?          @db.Uuid
  unlockedAt    DateTime?
  unlockReason  String?
  version       Int              @default(1)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  school      School      @relation(fields: [schoolId], references: [id])
  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)

  @@unique([examSubjectId, streamId], map: "result_submissions_unit_unique")
  @@index([schoolId, status])
  @@map("result_submissions")
}

// A missing row means "not entered yet". Absent and exempt are explicit states, never silently zero.
model Mark {
  id            String     @id @default(uuid(7)) @db.Uuid
  schoolId      String     @db.Uuid
  examSubjectId String     @db.Uuid
  studentId     String     @db.Uuid
  status        MarkStatus
  score         Decimal?   @db.Decimal(6, 2)
  enteredById   String     @db.Uuid
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  // Snapshot written when the result is locked, so later scale edits never change a locked result.
  lockedPercent Decimal?   @db.Decimal(5, 2)
  lockedGrade   String?
  lockedPoints  Int?
  lockedScaleId String?    @db.Uuid

  school      School      @relation(fields: [schoolId], references: [id])
  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)

  @@unique([examSubjectId, studentId])
  @@index([schoolId, studentId])
  @@map("marks")
}

// Append-only trail of every change made after marks were first submitted.
model ResultChange {
  id            String      @id @default(uuid(7)) @db.Uuid
  schoolId      String      @db.Uuid
  examSubjectId String      @db.Uuid
  studentId     String      @db.Uuid
  oldStatus     MarkStatus?
  oldScore      Decimal?    @db.Decimal(6, 2)
  newStatus     MarkStatus?
  newScore      Decimal?    @db.Decimal(6, 2)
  reason        String?
  changedById   String      @db.Uuid
  createdAt     DateTime    @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, examSubjectId, studentId])
  @@map("result_changes")
}

// ═════════════════════════ Phase 4: Report cards & portal ═════════════════════════

enum ReportCardStatus {
  GENERATED // built from locked results, visible to staff only
  PUBLISHED // visible to the student and linked guardians in the portal
  WITHDRAWN // taken back (reason kept); never visible in the portal; can be regenerated
}

// Class teacher and head teacher comments for one student in one term.
model ReportRemark {
  id              String   @id @default(uuid(7)) @db.Uuid
  schoolId        String   @db.Uuid
  studentId       String   @db.Uuid
  termId          String   @db.Uuid
  classRemark     String?
  headRemark      String?
  classRemarkById String?  @db.Uuid
  headRemarkById  String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([studentId, termId])
  @@index([schoolId, termId])
  @@map("report_remarks")
}

// One report card per student per term. The snapshot is the document: it is built once from locked results and
// does not change when marks, scales or remarks change later. Regenerating keeps the old snapshot in report_card_revisions.
model ReportCard {
  id             String           @id @default(uuid(7)) @db.Uuid
  schoolId       String           @db.Uuid
  studentId      String           @db.Uuid
  termId         String           @db.Uuid
  classId        String           @db.Uuid
  streamId       String?          @db.Uuid
  status         ReportCardStatus @default(GENERATED)
  version        Int              @default(1)
  snapshot       Json
  generatedById  String           @db.Uuid
  generatedAt    DateTime         @default(now())
  publishedById  String?          @db.Uuid
  publishedAt    DateTime?
  withdrawnById  String?          @db.Uuid
  withdrawnAt    DateTime?
  withdrawReason String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school    School               @relation(fields: [schoolId], references: [id])
  revisions ReportCardRevision[]

  @@unique([studentId, termId])
  @@index([schoolId, termId, classId])
  @@index([schoolId, studentId, status])
  @@map("report_cards")
}

// Append-only copies of superseded snapshots (trigger in the migration).
model ReportCardRevision {
  id            String   @id @default(uuid(7)) @db.Uuid
  reportCardId  String   @db.Uuid
  version       Int
  snapshot      Json
  generatedById String   @db.Uuid
  generatedAt   DateTime
  supersededAt  DateTime @default(now())

  reportCard ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)

  @@unique([reportCardId, version])
  @@map("report_card_revisions")
}

// ═════════════════════════ Phase 5: Fees & finance ═════════════════════════
// Money is DECIMAL(14,2) in the school currency (TZS). Originals are never edited: invoices are voided or adjusted by
// appended lines, payments are reversed, refunds go through a request/approve/pay workflow. A student's balance is
// always computed by one service (src/lib/finance/ledger.ts) from invoices, posted payments and active refunds.

enum FeeCategory {
  TUITION
  TRANSPORT
  MEALS
  BOARDING
  UNIFORM
  EXAM
  ADMISSION
  OTHER
}

enum DiscountKind {
  PERCENT
  FIXED
}

enum InvoiceType {
  TERM_FEES // generated from the fee structure; at most one live invoice per student and term
  OTHER // one-off charges
}

enum InvoiceStatus {
  ISSUED
  VOID
}

enum InvoiceLineKind {
  CHARGE
  DISCOUNT
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE_MONEY
  OTHER
}

enum PaymentStatus {
  POSTED
  REVERSED
}

enum PaymentSource {
  MANUAL
  PROVIDER
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
}

enum PaymentEventStatus {
  POSTED // verified, matched and recorded as a payment
  UNMATCHED // verified but could not be matched to exactly one student: waits in the reconciliation queue
  NOT_SUCCESSFUL // provider reported pending or failed: recorded, nothing posted
  REJECTED // a person rejected it from the queue
}

model FeeItem {
  id        String      @id @default(uuid(7)) @db.Uuid
  schoolId  String      @db.Uuid
  name      String
  nameSw    String?
  category  FeeCategory @default(TUITION)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  school School             @relation(fields: [schoolId], references: [id])
  lines  FeeStructureLine[]

  @@unique([schoolId, name])
  @@map("fee_items")
}

// What a class (or level, or everyone) is charged in an academic year. One active structure per scope and year
// (partial unique index in the migration). The most specific scope wins: class, then level, then all.
model FeeStructure {
  id             String   @id @default(uuid(7)) @db.Uuid
  schoolId       String   @db.Uuid
  academicYearId String   @db.Uuid
  name           String
  levelId        String?  @db.Uuid
  classId        String?  @db.Uuid
  isActive       Boolean  @default(true)
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school School             @relation(fields: [schoolId], references: [id])
  lines  FeeStructureLine[]

  @@index([schoolId, academicYearId])
  @@map("fee_structures")
}

// termSequence null = charged every term; N = only in the term with that sequence number (e.g. admission fee in term 1).
model FeeStructureLine {
  id           String  @id @default(uuid(7)) @db.Uuid
  structureId  String  @db.Uuid
  feeItemId    String  @db.Uuid
  amount       Decimal @db.Decimal(14, 2)
  termSequence Int?
  sortOrder    Int     @default(0)

  structure FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  feeItem   FeeItem      @relation(fields: [feeItemId], references: [id])

  // Real index is NULLS NOT DISTINCT (see migration SQL); declared here so Prisma does not drop it.
  @@unique([structureId, feeItemId, termSequence], map: "fee_structure_lines_unique")
  @@map("fee_structure_lines")
}

// Scholarship or discount for one student in one academic year; applied as DISCOUNT lines when invoices are generated.
model StudentDiscount {
  id             String       @id @default(uuid(7)) @db.Uuid
  schoolId       String       @db.Uuid
  studentId      String       @db.Uuid
  academicYearId String       @db.Uuid
  name           String
  kind           DiscountKind
  value          Decimal      @db.Decimal(14, 2)
  feeItemId      String?      @db.Uuid // null = applies to the whole invoice
  reason         String
  isActive       Boolean      @default(true)
  approvedById   String       @db.Uuid
  createdAt      DateTime     @default(now())
  endedAt        DateTime?
  endedById      String?      @db.Uuid

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, studentId, academicYearId])
  @@map("student_discounts")
}

model Invoice {
  id             String        @id @default(uuid(7)) @db.Uuid
  schoolId       String        @db.Uuid
  studentId      String        @db.Uuid
  academicYearId String        @db.Uuid
  termId         String?       @db.Uuid
  classId        String?       @db.Uuid // class at billing time
  number         String
  type           InvoiceType   @default(TERM_FEES)
  status         InvoiceStatus @default(ISSUED)
  issueDate      DateTime      @db.Date
  dueDate        DateTime      @db.Date
  notes          String?
  createdById    String        @db.Uuid
  createdAt      DateTime      @default(now())
  voidedAt       DateTime?
  voidedById     String?       @db.Uuid
  voidReason     String?

  school      School              @relation(fields: [schoolId], references: [id])
  lines       InvoiceLine[]
  instalments InvoiceInstalment[]
  payments    Payment[]

  @@unique([schoolId, number])
  @@index([schoolId, studentId])
  @@index([schoolId, termId, status])
  @@map("invoices")
}

// Append-only (trigger). Corrections add lines; nothing is edited or deleted.
model InvoiceLine {
  id          String          @id @default(uuid(7)) @db.Uuid
  invoiceId   String          @db.Uuid
  feeItemId   String?         @db.Uuid
  kind        InvoiceLineKind
  description String
  amount      Decimal         @db.Decimal(14, 2)
  reason      String? // set on lines added after issue (adjustments)
  createdById String          @db.Uuid
  createdAt   DateTime        @default(now())
  sortOrder   Int             @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("invoice_lines")
}

// Payment schedule only; allocation of money is done by the ledger, oldest first.
model InvoiceInstalment {
  id        String   @id @default(uuid(7)) @db.Uuid
  invoiceId String   @db.Uuid
  sequence  Int
  dueDate   DateTime @db.Date
  amount    Decimal  @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, sequence])
  @@map("invoice_instalments")
}

model Payment {
  id              String        @id @default(uuid(7)) @db.Uuid
  schoolId        String        @db.Uuid
  studentId       String        @db.Uuid
  targetInvoiceId String?       @db.Uuid // optional: pay this invoice first; any remainder is applied oldest-first
  method          PaymentMethod
  provider        String? // e.g. the mobile-money provider key
  reference       String? // bank slip number, transaction id
  amount          Decimal       @db.Decimal(14, 2)
  receivedOn      DateTime      @db.Date
  payerName       String?
  notes           String?
  status          PaymentStatus @default(POSTED)
  source          PaymentSource @default(MANUAL)
  idempotencyKey  String? // client-generated, protects against double submit
  createdById     String?       @db.Uuid // null for provider-confirmed payments
  createdAt       DateTime      @default(now())
  reversedAt      DateTime?
  reversedById    String?       @db.Uuid
  reverseReason   String?

  school        School   @relation(fields: [schoolId], references: [id])
  targetInvoice Invoice? @relation(fields: [targetInvoiceId], references: [id])
  receipt       Receipt?

  @@index([schoolId, studentId, status])
  @@index([schoolId, receivedOn])
  @@map("payments")
}

// One receipt per payment, numbered. The snapshot is the document; a reversed payment's receipt is marked void, never deleted.
model Receipt {
  id         String    @id @default(uuid(7)) @db.Uuid
  schoolId   String    @db.Uuid
  paymentId  String    @unique @db.Uuid
  number     String
  issuedAt   DateTime  @default(now())
  issuedById String?   @db.Uuid
  snapshot   Json
  voidedAt   DateTime?
  voidReason String?

  school  School  @relation(fields: [schoolId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@unique([schoolId, number])
  @@map("receipts")
}

// Money returned to a payer. Only unapplied credit can be refunded. Requested by one person, decided by another.
model Refund {
  id            String        @id @default(uuid(7)) @db.Uuid
  schoolId      String        @db.Uuid
  studentId     String        @db.Uuid
  amount        Decimal       @db.Decimal(14, 2)
  method        PaymentMethod
  reference     String?
  reason        String
  status        RefundStatus  @default(REQUESTED)
  requestedById String        @db.Uuid
  requestedAt   DateTime      @default(now())
  decidedById   String?       @db.Uuid
  decidedAt     DateTime?
  decisionNote  String?
  paidAt        DateTime?
  paidById      String?       @db.Uuid

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, studentId])
  @@index([schoolId, status])
  @@map("refunds")
}

enum ExpenseApproval {
  APPROVED
  PENDING
  REJECTED
}

model ExpenseCategory {
  id               String   @id @default(uuid(7)) @db.Uuid
  schoolId         String   @db.Uuid
  name             String
  isActive         Boolean  @default(true)
  requiresApproval Boolean  @default(false) // every expense in this category waits for an approver
  createdAt        DateTime @default(now())

  school   School    @relation(fields: [schoolId], references: [id])
  expenses Expense[]

  @@unique([schoolId, name])
  @@map("expense_categories")
}

model Expense {
  id           String          @id @default(uuid(7)) @db.Uuid
  schoolId     String          @db.Uuid
  categoryId   String          @db.Uuid
  amount       Decimal         @db.Decimal(14, 2)
  spentOn      DateTime        @db.Date
  payee        String
  description  String?
  method       PaymentMethod
  reference    String?
  voided       Boolean         @default(false)
  voidReason   String?
  voidedAt     DateTime?
  voidedById   String?         @db.Uuid
  createdById  String          @db.Uuid
  createdAt    DateTime        @default(now())
  // Approval: expenses the school marks as needing it start PENDING and count in no total until a second person approves them.
  approval     ExpenseApproval @default(APPROVED)
  approvedById String?         @db.Uuid
  approvedAt   DateTime?
  approvalNote String?

  school   School          @relation(fields: [schoolId], references: [id])
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([schoolId, spentOn])
  @@map("expenses")
}

// Every provider notification, stored once (unique per provider event id). Only verified SUCCESS events can create a payment.
model PaymentEvent {
  id              String             @id @default(uuid(7)) @db.Uuid
  schoolId        String             @db.Uuid
  provider        String
  providerEventId String
  providerStatus  String // as reported: SUCCESS | FAILED | PENDING
  status          PaymentEventStatus
  amount          Decimal?           @db.Decimal(14, 2)
  currency        String?
  reference       String? // the account / bill reference the payer used
  msisdn          String?
  occurredAt      DateTime?
  payloadHash     String
  payload         Json
  paymentId       String?            @db.Uuid
  studentId       String?            @db.Uuid
  note            String?
  resolvedById    String?            @db.Uuid
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, provider, providerEventId])
  @@index([schoolId, status])
  @@map("payment_events")
}

// ═════════════════════════ Phase 6: Communication ═════════════════════════

enum BroadcastKind {
  ANNOUNCEMENT
  FEE_REMINDER
}

enum NotificationCategory {
  ABSENCE
  FEES
  RESULTS
  ANNOUNCEMENTS
}

enum ThreadStatus {
  OPEN
  CLOSED
}

enum MessageVisibility {
  VISIBLE
  HIDDEN // removed by a moderator; the text is kept for the record but not shown to participants
}

// A notice or reminder sent to guardians. Creating it queues one outbox event per recipient (see NotificationEvent);
// delivery results are read from those events, never assumed. Cancelling stops events that have not been processed yet.
model Broadcast {
  id             String        @id @default(uuid(7)) @db.Uuid
  schoolId       String        @db.Uuid
  kind           BroadcastKind
  title          String
  bodyEn         String
  bodySw         String?
  audience       Json
  sendSms        Boolean       @default(true)
  sendInApp      Boolean       @default(true)
  sendAt         DateTime      @default(now())
  recipientCount Int           @default(0)
  createdById    String        @db.Uuid
  createdAt      DateTime      @default(now())
  cancelledAt    DateTime?
  cancelledById  String?       @db.Uuid

  school School              @relation(fields: [schoolId], references: [id])
  events NotificationEvent[]

  @@index([schoolId, createdAt])
  @@map("broadcasts")
}

// Per-user opt-outs by category and channel. No row = everything on.
model NotificationPreference {
  id           String               @id @default(uuid(7)) @db.Uuid
  userId       String               @db.Uuid
  category     NotificationCategory
  smsEnabled   Boolean              @default(true)
  inAppEnabled Boolean              @default(true)
  updatedAt    DateTime             @updatedAt

  @@unique([userId, category])
  @@map("notification_preferences")
}

// School wording for system messages (absence, fees, results), per language. No row = the built-in text.
model MessageTemplate {
  id          String   @id @default(uuid(7)) @db.Uuid
  schoolId    String   @db.Uuid
  key         String
  locale      Locale
  body        String
  updatedById String   @db.Uuid
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, key, locale])
  @@map("message_templates")
}

// Parent-teacher conversation about one student. staffUserId null = the school office (handled by moderators).
model MessageThread {
  id             String       @id @default(uuid(7)) @db.Uuid
  schoolId       String       @db.Uuid
  studentId      String       @db.Uuid
  guardianUserId String       @db.Uuid
  staffUserId    String?      @db.Uuid
  subject        String
  status         ThreadStatus @default(OPEN)
  createdAt      DateTime     @default(now())
  lastMessageAt  DateTime     @default(now())
  guardianReadAt DateTime?
  staffReadAt    DateTime?
  closedAt       DateTime?
  closedById     String?      @db.Uuid

  school   School          @relation(fields: [schoolId], references: [id])
  messages ThreadMessage[]

  @@index([schoolId, lastMessageAt])
  @@index([guardianUserId])
  @@index([staffUserId])
  @@map("message_threads")
}

model ThreadMessage {
  id           String            @id @default(uuid(7)) @db.Uuid
  threadId     String            @db.Uuid
  senderUserId String            @db.Uuid
  body         String
  visibility   MessageVisibility @default(VISIBLE)
  hiddenById   String?           @db.Uuid
  hiddenReason String?
  hiddenAt     DateTime?
  flaggedById  String?           @db.Uuid
  flaggedAt    DateTime?
  flagReason   String?
  createdAt    DateTime          @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id])

  @@index([threadId, createdAt])
  @@index([flaggedAt])
  @@map("thread_messages")
}

// ═════════════════════════ Learning hub ═════════════════════════
// Timetable, schemes of work and lesson plans, homework with submissions and feedback, portfolios, behaviour records.
// Built natively on the existing classes, subjects, teacher assignments and portal accounts.

enum PlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

enum SubmissionState {
  SUBMITTED // handed in, waiting for the teacher
  RETURNED // the teacher asked for a revision
  GRADED // marked; the family sees score and feedback only once released
}

enum SubmissionVia {
  ONLINE
  PAPER // the teacher recorded work handed in on paper (many students have no account)
}

enum LearningFileOwner {
  ASSIGNMENT
  SUBMISSION
  PORTFOLIO
}

enum PortfolioStatus {
  PENDING // added by the student, waiting for a teacher
  PUBLISHED // visible to the student and the family
  REMOVED
}

enum BehaviourType {
  POSITIVE
  CONCERN
  INCIDENT
}

model TimetablePeriod {
  id        String  @id @default(uuid(7)) @db.Uuid
  schoolId  String  @db.Uuid
  sequence  Int
  name      String
  startTime String // HH:MM, school time
  endTime   String
  isBreak   Boolean @default(false)

  school  School           @relation(fields: [schoolId], references: [id])
  entries TimetableEntry[]

  @@unique([schoolId, sequence])
  @@map("timetable_periods")
}

// One lesson in the weekly timetable. streamId null = the whole class. The partial unique indexes in the migration stop a
// teacher or a room being in two places at once and a class (stream) having two lessons in one period.
model TimetableEntry {
  id             String   @id @default(uuid(7)) @db.Uuid
  schoolId       String   @db.Uuid
  academicYearId String   @db.Uuid
  classId        String   @db.Uuid
  streamId       String?  @db.Uuid
  dayOfWeek      Int // 1 = Monday ... 7 = Sunday
  periodId       String   @db.Uuid
  subjectId      String   @db.Uuid
  teacherStaffId String?  @db.Uuid
  room           String?
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())

  school School          @relation(fields: [schoolId], references: [id])
  period TimetablePeriod @relation(fields: [periodId], references: [id])

  // Real index is NULLS NOT DISTINCT (see migration SQL); declared here so Prisma does not drop it.
  @@unique([academicYearId, classId, streamId, dayOfWeek, periodId], map: "timetable_class_slot_unique")
  @@index([schoolId, academicYearId, classId])
  @@index([teacherStaffId])
  @@map("timetable_entries")
}

model SchemeOfWork {
  id             String     @id @default(uuid(7)) @db.Uuid
  schoolId       String     @db.Uuid
  academicYearId String     @db.Uuid
  termId         String?    @db.Uuid
  classId        String     @db.Uuid
  subjectId      String     @db.Uuid
  teacherStaffId String     @db.Uuid
  title          String
  status         PlanStatus @default(DRAFT)
  reviewNote     String?
  submittedAt    DateTime?
  reviewedById   String?    @db.Uuid
  reviewedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  school School       @relation(fields: [schoolId], references: [id])
  weeks  SchemeWeek[]

  @@index([schoolId, teacherStaffId])
  @@index([schoolId, status])
  @@map("schemes_of_work")
}

model SchemeWeek {
  id         String  @id @default(uuid(7)) @db.Uuid
  schemeId   String  @db.Uuid
  weekNo     Int
  topic      String
  objectives String?
  activities String?
  resources  String?
  assessment String?
  periods    Int?

  scheme SchemeOfWork @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, weekNo])
  @@map("scheme_weeks")
}

model LessonPlan {
  id             String     @id @default(uuid(7)) @db.Uuid
  schoolId       String     @db.Uuid
  academicYearId String     @db.Uuid
  classId        String     @db.Uuid
  streamId       String?    @db.Uuid
  subjectId      String     @db.Uuid
  teacherStaffId String     @db.Uuid
  lessonDate     DateTime   @db.Date
  topic          String
  objectives     String
  activities     String
  resources      String?
  assessment     String?
  homework       String?
  reflection     String?
  status         PlanStatus @default(DRAFT)
  reviewNote     String?
  submittedAt    DateTime?
  reviewedById   String?    @db.Uuid
  reviewedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, teacherStaffId, lessonDate])
  @@index([schoolId, status])
  @@map("lesson_plans")
}

model Assignment {
  id             String    @id @default(uuid(7)) @db.Uuid
  schoolId       String    @db.Uuid
  academicYearId String    @db.Uuid
  classId        String    @db.Uuid
  streamId       String?   @db.Uuid
  subjectId      String    @db.Uuid
  teacherStaffId String?   @db.Uuid
  createdById    String    @db.Uuid
  title          String
  instructions   String
  dueAt          DateTime
  maxScore       Decimal?  @db.Decimal(6, 2) // null = not marked with a score
  publishedAt    DateTime? // null = draft, not visible to students or families
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school      School                 @relation(fields: [schoolId], references: [id])
  submissions AssignmentSubmission[]

  @@index([schoolId, classId, publishedAt])
  @@index([schoolId, teacherStaffId])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String          @id @default(uuid(7)) @db.Uuid
  schoolId     String          @db.Uuid
  assignmentId String          @db.Uuid
  studentId    String          @db.Uuid
  via          SubmissionVia   @default(ONLINE)
  text         String?
  state        SubmissionState @default(SUBMITTED)
  late         Boolean         @default(false)
  revision     Int             @default(1)
  submittedAt  DateTime        @default(now())
  score        Decimal?        @db.Decimal(6, 2)
  feedback     String?
  gradedById   String?         @db.Uuid
  gradedAt     DateTime?
  releasedAt   DateTime? // when the score and feedback became visible to the student and family
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  school     School     @relation(fields: [schoolId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([schoolId, studentId])
  @@map("assignment_submissions")
}

// An attachment (PDF, JPEG, PNG or WebP) in the file storage. Served only through a permission-checked route.
model LearningFile {
  id           String            @id @default(uuid(7)) @db.Uuid
  schoolId     String            @db.Uuid
  ownerKind    LearningFileOwner
  ownerId      String            @db.Uuid
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  uploadedById String            @db.Uuid
  createdAt    DateTime          @default(now())
  deletedAt    DateTime?

  school School @relation(fields: [schoolId], references: [id])

  @@index([ownerKind, ownerId])
  @@map("learning_files")
}

model PortfolioItem {
  id               String          @id @default(uuid(7)) @db.Uuid
  schoolId         String          @db.Uuid
  studentId        String          @db.Uuid
  subjectId        String?         @db.Uuid
  title            String
  description      String?
  createdById      String          @db.Uuid
  createdByStudent Boolean         @default(false)
  status           PortfolioStatus @default(PENDING)
  teacherComment   String?
  publishedAt      DateTime?
  publishedById    String?         @db.Uuid
  createdAt        DateTime        @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, studentId, status])
  @@map("portfolio_items")
}

// Never deleted: a wrong record is voided with a reason. Only records marked as shared are visible to the family.
model BehaviourRecord {
  id               String        @id @default(uuid(7)) @db.Uuid
  schoolId         String        @db.Uuid
  studentId        String        @db.Uuid
  occurredOn       DateTime      @db.Date
  type             BehaviourType
  category         String
  description      String
  action           String?
  sharedWithFamily Boolean       @default(false)
  recordedById     String        @db.Uuid
  createdAt        DateTime      @default(now())
  voidedAt         DateTime?
  voidedById       String?       @db.Uuid
  voidReason       String?

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, studentId, occurredOn])
  @@map("behaviour_records")
}

// Evidence of backups and restore tests. Written only by the backup scripts after the copy exists and its checksum is known;
// nothing in the app creates, edits or deletes these rows, so the status page can only report what really happened.
enum BackupKind {
  BACKUP
  RESTORE_TEST
}

enum BackupStatus {
  SUCCESS
  FAILED
}

model BackupRun {
  id         String       @id @default(uuid(7)) @db.Uuid
  kind       BackupKind   @default(BACKUP)
  status     BackupStatus
  startedAt  DateTime
  finishedAt DateTime     @default(now())
  fileName   String?
  sizeBytes  BigInt?
  sha256     String?
  location   String? // where the copy lives (a folder or a bucket path); never a credential
  rowCounts  Json? // key tables and their row counts at the time (restore tests compare source and copy)
  note       String? // for FAILED: the reason; for RESTORE_TEST: what was checked
  createdAt  DateTime     @default(now())

  @@index([kind, status, finishedAt])
  @@map("backup_runs")
}

// Monitoring for the system dashboard. Written best-effort by the app (never blocks a request) and trimmed after 30 days.
model ErrorEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  occurredAt DateTime @default(now())
  source     String // action | api | job
  name       String // error class, e.g. PrismaClientKnownRequestError
  message    String // cut short and scrubbed of e-mail addresses and long digit runs
  where      String? // action name or route
  userId     String?  @db.Uuid

  @@index([occurredAt])
  @@map("error_events")
}

model JobRun {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       String
  startedAt  DateTime
  finishedAt DateTime @default(now())
  ok         Boolean
  summary    Json?

  @@index([name, finishedAt])
  @@map("job_runs")
}
