# Copy to .env for local development. Never commit real values.
DATABASE_URL="postgresql://USER@localhost:5432/stanne_dev"
TEST_DATABASE_URL="postgresql://USER@localhost:5432/stanne_test"
APP_URL="http://localhost:3000"
# Used once by `npm run db:bootstrap` to create the first Super Admin.
BOOTSTRAP_ADMIN_NAME="System Administrator"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="choose-a-strong-password"

# ── Phase 2 ──
# Where uploaded documents are stored: "local" (development only, files under STORAGE_LOCAL_DIR) or "s3"
# (Cloudflare R2 / any S3-compatible bucket). In production with STORAGE_DRIVER unset, uploads are refused.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/uploads"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_BUCKET="st-anne-documents"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Maximum upload size in bytes (default 4 MB; Vercel functions accept at most ~4.5 MB request bodies).
# DOCUMENT_MAX_BYTES=4194304
# Bearer secret for the notification worker: GET /api/jobs/notifications with "Authorization: Bearer <secret>".
# CRON_SECRET=""

# ── Payment provider notifications (Phase 5) ──
# Leave all of these empty until the school has chosen a provider and received credentials: an unconfigured provider's
# webhook (POST /api/payments/webhook/<provider>) refuses everything. A secret must be at least 16 characters; the
# provider (or a gateway in front of it) signs the raw request body with HMAC-SHA256 and sends the hex digest in X-Signature.
PAYMENTS_SELCOM_WEBHOOK_SECRET=
PAYMENTS_AZAMPAY_WEBHOOK_SECRET=
PAYMENTS_CLICKPESA_WEBHOOK_SECRET=
PAYMENTS_BANK_WEBHOOK_SECRET=
# Which school receives provider notifications (its school code). Needed when more than one school exists.
PAYMENTS_SCHOOL_CODE=

# ── SMS delivery reports (Phase 6) ──
# No SMS provider is chosen yet, so SMS is recorded as "skipped" and nothing is shown as sent or delivered.
# When a provider is connected, POST /api/sms/webhook/<provider> accepts delivery reports signed with HMAC-SHA256
# (hex digest of the raw body in X-Signature). A secret must be at least 16 characters. Providers: selcom, azampay, clickpesa, gateway.
SMS_SELCOM_WEBHOOK_SECRET=
SMS_AZAMPAY_WEBHOOK_SECRET=
SMS_CLICKPESA_WEBHOOK_SECRET=
SMS_GATEWAY_WEBHOOK_SECRET=

# LOCAL TESTING ONLY: 1 = the family's application page shows a "pretend the fee was paid" button (no money moves).
# Ignored whenever NODE_ENV=production. Never set this on the live system.
PAYMENTS_SANDBOX=
