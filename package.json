{
  "name": "st-anne-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && tsx scripts/scan-site-media.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap.ts",
    "db:seed-demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "db:seed-demo:more": "tsx --env-file-if-exists=.env scripts/seed-demo-more.ts",
    "site:media": "tsx scripts/scan-site-media.ts",
    "predev": "tsx scripts/scan-site-media.ts",
    "db:backup": "tsx --env-file-if-exists=.env scripts/backup.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "framer-motion": "^14.4.0",
    "lucide-react": "^1.60.0",
    "next": "^16.4.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.6",
    "postcss": "^8.5.31",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
